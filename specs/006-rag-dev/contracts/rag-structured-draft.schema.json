{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:legal-ai:rag-structured-draft:v1",
  "title": "RagStructuredDraftV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "visto",
    "considerandos",
    "dispositive_intro",
    "articles",
    "closing",
    "authority",
    "signature",
    "sources",
    "warnings"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "title": { "$ref": "#/$defs/nonEmptyText" },
    "visto": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/citedParagraph" }
    },
    "considerandos": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/citedParagraph" }
    },
    "dispositive_intro": { "$ref": "#/$defs/nonEmptyText" },
    "articles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/article" }
    },
    "closing": { "$ref": "#/$defs/nonEmptyText" },
    "authority": { "$ref": "#/$defs/nonEmptyText" },
    "signature": { "$ref": "#/$defs/nonEmptyText" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "warnings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyText" }
    }
  },
  "$defs": {
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000,
      "pattern": ".*\\S.*"
    },
    "citationId": {
      "type": "string",
      "pattern": "^SRC-[0-9]{3}$"
    },
    "citedParagraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "citation_ids"],
      "properties": {
        "text": { "$ref": "#/$defs/nonEmptyText" },
        "citation_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/citationId" }
        }
      }
    },
    "article": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "text", "citation_ids"],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        },
        "text": { "$ref": "#/$defs/nonEmptyText" },
        "citation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/citationId" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citation_id",
        "external_id",
        "title",
        "publication_date",
        "section_type"
      ],
      "properties": {
        "citation_id": { "$ref": "#/$defs/citationId" },
        "external_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "publication_date": {
          "type": ["string", "null"],
          "format": "date"
        },
        "section_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "source_url": {
          "type": ["string", "null"],
          "format": "uri",
          "maxLength": 2048
        }
      }
    }
  }
}
