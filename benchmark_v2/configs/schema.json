{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legal-ai-infraestructure.local/benchmark-v2/result.schema.json",
  "title": "Benchmark v2 reproducible result envelope",
  "description": "Common data contract for FULL/PARTIAL multi-dimensional benchmark results.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "run_id", "status", "metadata", "dimensions", "records"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "benchmark-v2.result.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["FULL", "PARTIAL"]
    },
    "expected_count": {
      "type": "integer",
      "minimum": 0
    },
    "dimensions": {
      "$ref": "#/$defs/dimensions"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "records_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "result_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "dimensions": {
      "type": "object",
      "description": "Named coordinates/parameters. Arbitrary dimensions are supported.",
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean", "null"]
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "version", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": true,
      "required": ["commit"],
      "properties": {
        "commit": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": ["run_id", "generated_at_utc", "seed", "dimensions"],
      "anyOf": [
        {"required": ["dataset", "code"]},
        {"required": ["dataset_hash", "code_version"]},
        {"required": ["dataset_hash", "git_commit"]}
      ],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "dataset": {"$ref": "#/$defs/dataset"},
        "code": {"$ref": "#/$defs/code"},
        "generated_at_utc": {"type": "string", "format": "date-time"},
        "seed": {"type": "integer"},
        "dimensions": {"$ref": "#/$defs/dimensions"},
        "environment": {"type": "object", "additionalProperties": true},
        "parameters": {"type": "object", "additionalProperties": true}
      }
    },
    "record": {
      "type": "object",
      "description": "One observation. Its dimensions may refine the envelope dimensions.",
      "additionalProperties": true,
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "case_id": {"type": "string", "minLength": 1},
        "dimensions": {"$ref": "#/$defs/dimensions"}
      }
    }
  },
  "$comment": "A FULL result must contain expected_count records; PARTIAL results must state their coverage in metadata/summary. This cardinality rule is enforced by benchmark_v2.results.schema.validate_result."
}


