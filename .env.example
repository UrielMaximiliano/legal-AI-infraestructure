# Entorno
APP_ENV=development
APP_NAME=legal-ai-api
APP_VERSION=0.1.0

# API
API_HOST=0.0.0.0
API_PORT=8000
LEGAL_AI_SERVICE_TOKEN=<PLACEHOLDER>
LOG_LEVEL=INFO

# PostgreSQL legado: contiene el RAG de decretos existente. No mezclar con IMI LEG.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=legal_ai
POSTGRES_USER=legal_ai
POSTGRES_PASSWORD=change-me

# IMI LEG core: Better Auth (mismo PostgreSQL, schema auth), empleados,
# expedientes, templates, documentos, revisiones y exportaciones.
IMI_CORE_POSTGRES_HOST=127.0.0.1
IMI_CORE_POSTGRES_PORT=55434
IMI_CORE_POSTGRES_DB=imi_leg_core
IMI_CORE_POSTGRES_USER=imi_leg_core
IMI_CORE_POSTGRES_PASSWORD=change-me-core

# Índice legal aislado de IMI LEG: copia re-embebida del corpus revisado.
# No contiene plantillas, drafts ni outputs de IMI.
IMI_DISPOSITIONS_RAG_POSTGRES_HOST=127.0.0.1
IMI_DISPOSITIONS_RAG_POSTGRES_PORT=55435
IMI_DISPOSITIONS_RAG_POSTGRES_DB=imi_disposiciones_rag
IMI_DISPOSITIONS_RAG_POSTGRES_USER=imi_disposiciones_rag
IMI_DISPOSITIONS_RAG_POSTGRES_PASSWORD=change-me-dispositions

# Ollama
OLLAMA_EMBEDDING_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_TOKEN=<PLACEHOLDER>
OLLAMA_EMBEDDING_TIMEOUT_SECONDS=30
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b-q4_K_M
# Use /api/embeddings for the documented external proxy; /api/embed is native batch.
OLLAMA_EMBEDDING_ENDPOINT=/api/embed
OLLAMA_EMBEDDING_CONTEXT_LENGTH=2048
EMBEDDING_DIMENSIONS=2560

# Perfil IMI LEG: se activa solamente en compose.imi-leg.yaml y usa 0.6B/1024.
LEGAL_AI_RUNTIME_PROFILE=legacy
OLLAMA_GENERATION_NUM_CTX=16384

# Corpus 005 (los límites son defensivos y no contienen secretos)
OLLAMA_EMBEDDING_BATCH_SIZE=16
CORPUS_MAX_FILE_SIZE_BYTES=2097152
CORPUS_MAX_BATCH_FILES=10000
CORPUS_MAX_CHUNKS=100000
EMBEDDING_QUEUE_MAX_SIZE=32
EMBEDDING_WAIT_TIMEOUT_SECONDS=30
CORPUS_ALLOWED_EXTENSIONS=[".txt", ".json", ".html"]
SEMANTIC_SEARCH_REVIEWED_ONLY=true
SEMANTIC_SEARCH_MAX_TOP_K=50
SEMANTIC_SEARCH_TIMEOUT_SECONDS=10
SEMANTIC_SEARCH_MINIMUM_SCORE=0.0

# RAG 006 (structured generation; tokens stay outside Git)
OLLAMA_GENERATION_BASE_URL=http://host.docker.internal:11434
OLLAMA_GENERATION_ENDPOINT=/api/chat
OLLAMA_GENERATION_MODEL=qwen3.6:35b
OLLAMA_GENERATION_TOKEN=<PLACEHOLDER>
OLLAMA_GENERATION_TIMEOUT_SECONDS=300
OLLAMA_GENERATION_MAX_RETRIES=1
RAG_PROMPT_VERSION=rag-legal-document-v1
RAG_SCHEMA_VERSION=1
RAG_TOP_K=8
RAG_CANDIDATE_POOL_SIZE=24
RAG_MINIMUM_SCORE=0.0
RAG_MAX_CONTEXT_BYTES=65536
RAG_MAX_CONTEXT_TOKENS_ESTIMATE=16384
RAG_MAX_CHUNKS_PER_DOCUMENT=2
RAG_MAX_CHUNKS_PER_SECTION=1
RAG_SCHEMA_REPAIR_ATTEMPTS=1
RAG_REQUIRE_REVIEWED=true
RAG_REQUIRED_EVALUATION_SPLIT=INDEX_90

# Exportaciones 004 (rutas locales; no contienen PII)
# Valores binarios exactos: MiB = 1.048.576 bytes. Los renderers DOCX/PDF
# usan procesos hijos spawn por operación y no dependen de LibreOffice.
EXPORT_STORAGE_ROOT=/var/lib/legal-ai/exports
DOCX_GENERATION_TIMEOUT_SECONDS=30
PDF_GENERATION_TIMEOUT_SECONDS=60
MAX_DOCX_SIZE_BYTES=20971520
MAX_PDF_SIZE_BYTES=31457280
MAX_PREVIEW_SIZE_BYTES=5242880
MAX_FINAL_SNAPSHOT_BYTES=2097152
MAX_EDITABLE_CONTENT_BYTES=2097152
MAX_FILE_NAME_LENGTH=120
MAX_RELATIVE_PATH_LENGTH=500
MAX_FINALIZATION_NOTES_LENGTH=2000
MAX_PAGE_SIZE=100
EXPORT_IDEMPOTENCY_WINDOW_HOURS=24
EXPORT_FAILED_ATTEMPT_RETENTION_DAYS=180
EXPORT_TEMP_RETENTION_HOURS=24
EXPORT_ORPHAN_RETENTION_DAYS=7
EXPORT_PDF_EOF_TAIL_BYTES=4096
